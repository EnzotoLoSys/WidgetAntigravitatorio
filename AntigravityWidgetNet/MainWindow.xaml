<Window x:Class="AntigravityWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Widget"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style TargetType="Ellipse">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        
        <!-- Dark ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.2" CornerRadius="8" Padding="4,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#334155" Margin="4,3,4,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid x:Name="GridItem">
                            <Border x:Name="BgBorder" Background="Transparent" CornerRadius="5" Margin="2,1" Height="26">
                                <Grid Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkmark Icon -->
                                    <TextBlock x:Name="CheckGlyph" Grid.Column="0" Text="✓" FontSize="11" FontWeight="Bold" 
                                               Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                    <!-- Header Text -->
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="2,0,8,0"/>

                                    <!-- Arrow for Submenu -->
                                    <TextBlock x:Name="ArrowGlyph" Grid.Column="2" Text="›" FontSize="12" FontWeight="Bold" 
                                               Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Submenu Popup -->
                            <Popup x:Name="SubMenuPopup" AllowsTransparency="True" Placement="Right" 
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.2" CornerRadius="8" Padding="4,4" Margin="2">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Highlight (Hover) -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Submenu Open -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <!-- Has Submenu Items -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="ArrowGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Is Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer" Margin="4" Background="#00000000">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <!-- Main Card Border (Snug & Ultra-Compact) -->
        <Border x:Name="MainBorder" CornerRadius="10" BorderThickness="1.2" Cursor="SizeAll">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="BorderGrad" StartPoint="0,0" EndPoint="1,1" Opacity="1.0">
                    <GradientStop Color="#60A5FA" Offset="0.0"/>
                    <GradientStop Color="#1E293B" Offset="0.5"/>
                    <GradientStop Color="#00F2FE" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush x:Name="BgBrush" Color="#0B0F19" Opacity="0.90"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.85"/>
            </Border.Effect>

            <!-- Right-Click Context Menu -->
            <Border.ContextMenu>
                <ContextMenu x:Name="WidgetContextMenu">
                    <MenuItem Header="Cambiar Vista">
                        <MenuItem x:Name="CtxModeBars" Header="Barras" Click="OnModeBarsClick"/>
                        <MenuItem x:Name="CtxModeGauges" Header="Tacometros" Click="OnModeGaugesClick"/>
                        <MenuItem x:Name="CtxModeChips" Header="Solo Porcentajes" Click="OnModeChipsClick"/>
                    </MenuItem>
                    <MenuItem Header="Orientacion">
                        <MenuItem x:Name="CtxOrientH" Header="Horizontal (Fila)" Click="OnOrientHClick"/>
                        <MenuItem x:Name="CtxOrientV" Header="Vertical (Columna)" Click="OnOrientVClick"/>
                    </MenuItem>
                    <MenuItem Header="Modelos Visibles">
                        <MenuItem x:Name="CtxShowGemini" Header="Gemini (Flash / Pro)" IsCheckable="True" Click="OnToggleGeminiClick"/>
                        <MenuItem x:Name="CtxShowGpt" Header="ChatGPT / Claude (GPT / 3P)" IsCheckable="True" Click="OnToggleGptClick"/>
                    </MenuItem>
                    <MenuItem x:Name="CtxCenterTaskbar" Header="Centrar en Barra de Tareas" Click="OnCenterTaskbarClick"/>
                    <MenuItem x:Name="CtxTaskbarPreset" Header="Preset: Estilo Barra de Tareas" Click="OnTaskbarPresetClick"/>
                    <MenuItem x:Name="CtxResetPos" Header="Centrar en Pantalla" Click="OnResetPosClick"/>
                    <Separator Background="#334155"/>
                    <MenuItem x:Name="CtxLockTaskbar" Header="Bloquear posicion (evitar arrastrar)" IsCheckable="True" Click="OnLockTaskbarClick"/>
                    <MenuItem x:Name="CtxAutoStart" Header="Iniciar con Windows" IsCheckable="True" Click="OnAutoStartClick"/>
                    <MenuItem x:Name="CtxPin" Header="Siempre arriba" IsCheckable="True" Click="OnPinClick"/>
                    <MenuItem x:Name="CtxClickThrough" Header="Modo Fantasma (Click-Through)" IsCheckable="True" Click="OnClickThroughClick"/>
                    <MenuItem x:Name="CtxSettings" Header="Preferencias..." Click="OnSettingsClick"/>
                    <Separator Background="#334155"/>
                    <MenuItem x:Name="CtxRefresh" Header="Actualizar ahora" Click="OnRefreshClick"/>
                    <Separator Background="#334155"/>
                    <MenuItem x:Name="CtxClose" Header="Cerrar Widget" Click="OnCloseClick"/>
                </ContextMenu>
            </Border.ContextMenu>

            <StackPanel Margin="6,5,6,5">
                <!-- ================= VISTA 1: BARRAS COMPACTAS ================= -->
                <StackPanel x:Name="ViewBars" Visibility="Visible" Width="175">
                    <!-- 5-Hour Rolling Limit (Gemini) -->
                    <StackPanel x:Name="Row5h" Margin="0,0,0,3.5">
                        <Grid Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" Fill="#06B6D4" Margin="0,0,3,0"/>
                                <TextBlock x:Name="Lbl5h" Text="Gemini 5h" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="Txt5hPct" Text="85%" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#4ADE80"/>
                        </Grid>
                        <Grid Height="4.5">
                            <Border x:Name="Prog5hBg" Background="#1E293B" CornerRadius="2.2"/>
                            <ProgressBar x:Name="Prog5h" Value="85" Maximum="100" Height="4.5" BorderThickness="0" Background="Transparent">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#06B6D4" Offset="0"/>
                                        <GradientStop Color="#10B981" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>
                        <TextBlock x:Name="Txt5hReset" Text="~30m (0p)" FontSize="7.5" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Weekly Quota (Gemini) -->
                    <StackPanel x:Name="RowWeekly" Margin="0,0,0,3.5">
                        <Grid Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" Fill="#3B82F6" Margin="0,0,3,0"/>
                                <TextBlock x:Name="LblWeekly" Text="Gemini Sem" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtWeeklyPct" Text="94%" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Grid>
                        <Grid Height="4.5">
                            <Border x:Name="ProgWeeklyBg" Background="#1E293B" CornerRadius="2.2"/>
                            <ProgressBar x:Name="ProgWeekly" Value="94" Maximum="100" Height="4.5" BorderThickness="0" Background="Transparent">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>
                        <TextBlock x:Name="TxtWeeklyDetails" Text="0 prompts" FontSize="7.5" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- 5-Hour Rolling Limit (ChatGPT / Claude) -->
                    <StackPanel x:Name="RowGpt5h" Margin="0,0,0,3.5">
                        <Grid Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" Fill="#10B981" Margin="0,0,3,0"/>
                                <TextBlock x:Name="LblGpt5h" Text="GPT 5h" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGpt5hPct" Text="100%" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                        </Grid>
                        <Grid Height="4.5">
                            <Border x:Name="ProgGpt5hBg" Background="#1E293B" CornerRadius="2.2"/>
                            <ProgressBar x:Name="ProgGpt5h" Value="100" Maximum="100" Height="4.5" BorderThickness="0" Background="Transparent">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#34D399" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>
                        <TextBlock x:Name="TxtGpt5hReset" Text="100%" FontSize="7.5" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Weekly Quota (ChatGPT / Claude) -->
                    <StackPanel x:Name="RowGptWeekly" Margin="0,0,0,3.5">
                        <Grid Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" Fill="#F59E0B" Margin="0,0,3,0"/>
                                <TextBlock x:Name="LblGptWeekly" Text="GPT Sem" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGptWeeklyPct" Text="37%" HorizontalAlignment="Right" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B"/>
                        </Grid>
                        <Grid Height="4.5">
                            <Border x:Name="ProgGptWeeklyBg" Background="#1E293B" CornerRadius="2.2"/>
                            <ProgressBar x:Name="ProgGptWeekly" Value="37" Maximum="100" Height="4.5" BorderThickness="0" Background="Transparent">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>
                        <TextBlock x:Name="TxtGptWeeklyDetails" Text="~5d 12h" FontSize="7.5" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Context Window Tokens -->
                    <StackPanel x:Name="RowContext" Margin="0,0,0,0">
                        <Grid Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" Fill="#A855F7" Margin="0,0,3,0"/>
                                <TextBlock x:Name="LblContext" Text="Contexto" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtContextTokens" Text="18k (2%)" HorizontalAlignment="Right" FontSize="9" Foreground="#C084FC"/>
                        </Grid>
                        <Grid Height="4">
                            <Border x:Name="ProgContextBg" Background="#1E293B" CornerRadius="2"/>
                            <ProgressBar x:Name="ProgContext" Value="2" Maximum="100" Height="4" BorderThickness="0" Background="Transparent">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ================= VISTA 2: TACOMETROS RADIALES ================= -->
                <StackPanel x:Name="ViewGauges" Orientation="Horizontal" Visibility="Collapsed" Margin="0">
                    <!-- Gauge 1: Gem 5H -->
                    <StackPanel x:Name="GaugeItem5h" Margin="2,0,2,0" HorizontalAlignment="Center">
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="Gauge5hBgRing" Stroke="#1E293B" StrokeThickness="4"/>
                            <Ellipse x:Name="Gauge5hRing" Stroke="#10B981" StrokeThickness="4" StrokeDashArray="21.3 40" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtGauge5hVal" Text="85%" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#4ADE80"/>
                                <TextBlock x:Name="LblGauge5h" Text="GEM 5H" FontSize="6.0" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Gauge 2: Gem Weekly -->
                    <StackPanel x:Name="GaugeItemWeekly" Margin="2,0,2,0" HorizontalAlignment="Center">
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="GaugeWeeklyBgRing" Stroke="#1E293B" StrokeThickness="4"/>
                            <Ellipse x:Name="GaugeWeeklyRing" Stroke="#38BDF8" StrokeThickness="4" StrokeDashArray="29.5 40" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtGaugeWeeklyVal" Text="94%" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#38BDF8"/>
                                <TextBlock x:Name="LblGaugeWeekly" Text="GEM SEM" FontSize="6.0" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Gauge 3: GPT 5H -->
                    <StackPanel x:Name="GaugeItemGpt5h" Margin="2,0,2,0" HorizontalAlignment="Center">
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="GaugeGpt5hBgRing" Stroke="#1E293B" StrokeThickness="4"/>
                            <Ellipse x:Name="GaugeGpt5hRing" Stroke="#10B981" StrokeThickness="4" StrokeDashArray="33 40" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtGaugeGpt5hVal" Text="100%" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#10B981"/>
                                <TextBlock x:Name="LblGaugeGpt5h" Text="GPT 5H" FontSize="6.0" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Gauge 4: GPT Weekly -->
                    <StackPanel x:Name="GaugeItemGptWeekly" Margin="2,0,2,0" HorizontalAlignment="Center">
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="GaugeGptWeeklyBgRing" Stroke="#1E293B" StrokeThickness="4"/>
                            <Ellipse x:Name="GaugeGptWeeklyRing" Stroke="#F59E0B" StrokeThickness="4" StrokeDashArray="12.3 40" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtGaugeGptWeeklyVal" Text="37%" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#F59E0B"/>
                                <TextBlock x:Name="LblGaugeGptWeekly" Text="GPT SEM" FontSize="6.0" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Gauge 5: Context -->
                    <StackPanel x:Name="GaugeItemContext" Margin="2,0,2,0" HorizontalAlignment="Center">
                        <Grid Width="46" Height="46">
                            <Ellipse x:Name="GaugeContextBgRing" Stroke="#1E293B" StrokeThickness="4"/>
                            <Ellipse x:Name="GaugeContextRing" Stroke="#A855F7" StrokeThickness="4" StrokeDashArray="2.0 40" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtGaugeContextVal" Text="2%" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Foreground="#C084FC"/>
                                <TextBlock x:Name="LblGaugeContext" Text="CTX" FontSize="6.0" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ================= VISTA 3: SOLO PORCENTAJES (CHIPS) ================= -->
                <StackPanel x:Name="ViewChips" Orientation="Horizontal" Visibility="Collapsed" Margin="0">
                    <!-- Chip 1: Gem 5H -->
                    <Border x:Name="ChipItem5h" Background="#132338" CornerRadius="6" Padding="5,3" Margin="2,0,2,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblChip5h" Text="GEM 5H" FontSize="6.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtChip5h" Text="85%" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip 2: Gem Weekly -->
                    <Border x:Name="ChipItemWeekly" Background="#142442" CornerRadius="6" Padding="5,3" Margin="2,0,2,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblChipWeekly" Text="GEM SEM" FontSize="6.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtChipWeekly" Text="94%" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip 3: GPT 5H -->
                    <Border x:Name="ChipItemGpt5h" Background="#132B25" CornerRadius="6" Padding="5,3" Margin="2,0,2,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblChipGpt5h" Text="GPT 5H" FontSize="6.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtChipGpt5h" Text="100%" FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip 4: GPT Weekly -->
                    <Border x:Name="ChipItemGptWeekly" Background="#2B2313" CornerRadius="6" Padding="5,3" Margin="2,0,2,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblChipGptWeekly" Text="GPT SEM" FontSize="6.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtChipGptWeekly" Text="37%" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Chip 5: Context -->
                    <Border x:Name="ChipItemContext" Background="#241838" CornerRadius="6" Padding="5,3" Margin="2,0,2,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LblChipContext" Text="CONTEXT" FontSize="6.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtChipContext" Text="2%" FontSize="10" FontWeight="Bold" Foreground="#C084FC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
